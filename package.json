{
  "name": "resilisense-api",
  "version": "2.0.0-alpha.0",
  "description": "ResiliSense 2.0 API — multi-tenant CSR/ESG assessment platform (see docs/revamp)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev": "nest start --watch",
    "worker:dev": "nest start --watch --entryFile src/worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node -r @swc-node/register prisma/seed/index.ts",
    "openapi": "node -r @swc-node/register scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi && git diff --exit-code openapi.json",
    "seed:owner": "node -r @swc-node/register scripts/seed-owner.ts",
    "postinstall": "prisma generate",
    "test:watch": "vitest",
    "audit": "audit-ci --config audit-ci.jsonc"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.10",
    "dotenv": "^18.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "minio": "^8.0.7",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.1",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "audit-ci": "^7.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "globals": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
