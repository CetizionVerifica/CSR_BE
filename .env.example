# Copy to .env for local development. Never commit real secrets (CLAUDE.md).
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://resilisense:resilisense@localhost:5432/resilisense_dev
TEST_DATABASE_URL=postgresql://resilisense:resilisense@localhost:5432/resilisense_test
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# Storage: local (dev, tests, Claude Code cloud sessions) | s3 (any S3-API-compatible store; no AWS — ADR-011)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Email: log (dev/tests) | smtp | postmark
EMAIL_DRIVER=log
EMAIL_FROM=ResiliSense <notifications@resilisense.org>
SMTP_URL=
POSTMARK_SERVER_TOKEN=
