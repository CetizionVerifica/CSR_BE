# Copy to .env for local development. Never commit real secrets (CLAUDE.md).
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://resilisense:resilisense@localhost:5432/resilisense_dev
TEST_DATABASE_URL=postgresql://resilisense:resilisense@localhost:5432/resilisense_test
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug

# Storage: local (dev, tests, Claude Code cloud sessions) | s3 (any S3-API-compatible store; no AWS — ADR-011)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Email: log (dev/tests) | smtp | postmark
EMAIL_DRIVER=log
EMAIL_FROM=ResiliSense <notifications@resilisense.org>
SMTP_URL=
POSTMARK_SERVER_TOKEN=

# Reverse proxies whose X-Forwarded-For is trusted (Express "trust proxy" syntax)
TRUST_PROXY=loopback, uniquelocal

# Identity (M01). Leave keys empty in development: ephemeral keys are generated at boot
# (sessions do not survive a restart). Production requires all three, injected by Kamal.
#   JWT key:  openssl genpkey -algorithm ed25519 | base64 -w0
#   MFA key:  openssl rand -base64 32      IP hash key: openssl rand -base64 32
JWT_PRIVATE_KEY=
JWT_KEY_ID=k1
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=https://api.resilisense.org
JWT_AUDIENCE=resilisense-app
MFA_ENCRYPTION_KEY=
IP_HASH_KEY=
# hibp (Have I Been Pwned range API, k-anonymity) | off
BREACHED_PASSWORD_CHECK=hibp
TERMS_VERSION=2026-09
TRIAL_MODULES=gap
